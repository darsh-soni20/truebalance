{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "Minimal Dark-Mode Expense Tracker App with User & Admin Panels",
  "main": "main.js",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start:backend": "node backend/server.js",
    "start:frontend": "npm --prefix frontend run dev",
    "start:electron": "npx electron .",
    "dev": "concurrently --kill-others \"npm run start:backend\" \"npm run start:electron\"",
    "web": "concurrently --kill-others \"npm run start:backend\" \"npm run start:frontend\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
