# Server Port
PORT=5000

# Node Environment (development / production)
NODE_ENV=production

# High-Entropy JWT Session Secret Key (Mandatory in Production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Payment Gateway API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
MERCHANT_UPI_ID=truebalance@upi

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Frontend API Base URL (for Vite build)
VITE_API_BASE=https://truebalance-7i5t.onrender.com
